{
  "name": "heading-tiers",
  "version": "0.1.1",
  "description": "Indent notes by heading nesting, with guide lines colored per heading level.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "heading",
    "indent",
    "outline"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
